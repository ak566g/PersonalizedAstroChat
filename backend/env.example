# Copy to ".env" and adjust. Every value below is also the built-in default,
# so the app runs without a .env file at all.

# Graph storage: "neo4j" (falls back to in-memory automatically if unreachable) or "memory"
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=astrochat-dev-pw

# LLM: "mock" (no key needed) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# Relative to the directory you start the server from; identical on Windows and macOS
DATA_DIR=./data

# Max long-term facts selected per request, and short-term turns sent to the LLM
CONTEXT_TOP_N=5
SHORT_TERM_TURNS=10